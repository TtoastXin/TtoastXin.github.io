---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes } from '../../lib/content';
import { formatMonth } from '../../lib/url';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, description, date, updated, draft } = note.data;
const { Content } = await render(note);
---

<BaseLayout title={title} description={description} type="article">
  <article>
    <header class="page-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString().slice(0, 10)}>{formatMonth(date)}</time>
        {updated && <span> · updated {formatMonth(updated)}</span>}
        {draft && <span class="draft">draft</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
