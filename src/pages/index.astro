---
import ContactLinks from '../components/ContactLinks.astro';
import NoteList from '../components/NoteList.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { news } from '../data/news';
import { talks } from '../data/talks';
import { getNotes, getPublications } from '../lib/content';
import { withBase } from '../lib/url';
import { site } from '../site.config';

const [publications, notes] = await Promise.all([getPublications(), getNotes()]);
const recentNotes = notes.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  affiliation: {
    '@type': 'ResearchOrganization',
    name: site.affiliation.name,
    url: site.affiliation.url,
  },
  knowsAbout: [
    'Test-time adaptation',
    'Generative models',
    'Inverse problems',
    'Simulation-based inference',
    'MRI reconstruction',
    'Medical image analysis',
  ],
  sameAs: [site.github, site.scholar].filter((url) => url !== undefined),
  ...(site.photo && Astro.site && { image: new URL(withBase(site.photo), Astro.site).href }),
  ...(Astro.site && { url: new URL(withBase('/'), Astro.site).href }),
};
---

<BaseLayout type="profile" jsonLd={jsonLd}>
  <section class="intro" aria-labelledby="intro-name">
    {site.photo && (
      <img
        class="photo"
        src={withBase(site.photo)}
        alt={`Portrait of ${site.name}`}
        width="640"
        height="640"
      />
    )}
    <div>
      <h1 id="intro-name">{site.name}</h1>
      <p class="affiliation">
        {site.role}, {site.affiliation.department}
        <br />
        <a href={site.affiliation.url}>{site.affiliation.name}</a>, {site.affiliation.city}
      </p>
      {site.bio.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <ContactLinks />
    </div>
  </section>

  {news.length > 0 && (
    <section class="section" aria-labelledby="news-heading">
      <div class="section-head">
        <h2 id="news-heading">News</h2>
      </div>
      <ul class="dated">
        {news.map((item) => (
          <li>
            <span class="meta">{item.date}</span>
            <span>
              {item.text}
              {item.link && (
                <>
                  {' '}
                  <a href={item.link.url}>[{item.link.label}]</a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {publications.length > 0 && (
    <section class="section" aria-labelledby="publications-heading">
      <div class="section-head">
        <h2 id="publications-heading">Publications</h2>
        {site.scholar && <a href={site.scholar}>Google Scholar</a>}
      </div>
      <ol class="plain">
        {publications.map((publication) => (
          <PublicationEntry publication={publication} />
        ))}
      </ol>
    </section>
  )}

  {talks.length > 0 && (
    <section class="section" aria-labelledby="talks-heading">
      <div class="section-head">
        <h2 id="talks-heading">Talks and posters</h2>
      </div>
      <ul class="dated">
        {talks.map((talk) => (
          <li>
            <span class="meta">{talk.date}</span>
            <span>
              <span class="talk-title">{talk.title}</span>
              <br />
              <span class="muted">
                {talk.kind} · {talk.event}, {talk.place}
              </span>
              {talk.link && (
                <>
                  {' '}
                  <a href={talk.link.url}>[{talk.link.label}]</a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recentNotes.length > 0 && (
    <section class="section" aria-labelledby="notes-heading">
      <div class="section-head">
        <h2 id="notes-heading">Notes</h2>
        {notes.length > recentNotes.length && <a href={withBase('/notes/')}>All notes</a>}
      </div>
      <NoteList notes={recentNotes} />
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2.25rem;
    align-items: start;
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
  }

  h1 {
    margin-bottom: 0.4rem;
  }

  .affiliation {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .intro :global(.contact) {
    margin-top: 1.25rem;
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .dated {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .dated li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding-block: 0.6rem;
  }

  .dated li + li {
    border-top: 1px solid var(--rule);
  }

  .dated .meta {
    padding-top: 0.2rem;
  }

  .talk-title {
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .photo {
      width: 8.5rem;
    }

    .dated li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
